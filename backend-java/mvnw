#!/bin/sh
# Maven Wrapper: runs Maven without needing "mvn" installed.
# Uses cached Maven in .mvn/cache or downloads it on first run.

set -e
MAVEN_VERSION="3.9.9"
MAVEN_ZIP="apache-maven-${MAVEN_VERSION}-bin.zip"
MAVEN_URL="https://repo.maven.apache.org/maven2/org/apache/maven/apache-maven/${MAVEN_VERSION}/${MAVEN_ZIP}"
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
CACHE_DIR="${SCRIPT_DIR}/.mvn/cache"
MAVEN_HOME="${CACHE_DIR}/apache-maven-${MAVEN_VERSION}"
MVN_CMD="${MAVEN_HOME}/bin/mvn"

if command -v mvn >/dev/null 2>&1; then
  exec mvn "$@"
fi

if [ -x "${MVN_CMD}" ]; then
  exec "${MVN_CMD}" "$@"
fi

echo "Maven not found. Downloading Maven ${MAVEN_VERSION} (one-time)..."
mkdir -p "${CACHE_DIR}"
cd "${CACHE_DIR}"
if [ ! -f "${MAVEN_ZIP}" ]; then
  if command -v curl >/dev/null 2>&1; then
    curl -sL -o "${MAVEN_ZIP}" "${MAVEN_URL}"
  else
    echo "Need curl to download Maven. Install curl or run: brew install maven"
    exit 1
  fi
fi
if [ ! -d "apache-maven-${MAVEN_VERSION}" ]; then
  unzip -q -o "${MAVEN_ZIP}"
fi
cd "${SCRIPT_DIR}"
exec "${MVN_CMD}" "$@"
